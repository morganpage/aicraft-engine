# OpenAI API key for the showcase's dev-time art generation pipeline.
# Required by: showcase/_scripts/gen-parallax-tiles.ts
# Get one at: https://platform.openai.com/api-keys
# Copy this file to `.env` and fill in your key. `.env` is gitignored.
# The key is used ONLY at dev-time to call gpt-image-2; it is never imported
# by the showcase runtime and never shipped to the bundle.
OPENAI_API_KEY=your-key-here
