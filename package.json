{
  "name": "aicraft-engine",
  "version": "0.18.0",
  "type": "module",
  "description": "Ultra-minimalist procedural rendering + algorithmic cosmetics + IAP bridge for indie and procedural games. Zero runtime dependencies.",
  "keywords": [
    "canvas2d",
    "procedural",
    "pixel-art",
    "platformer",
    "game-engine",
    "game-development",
    "typescript",
    "deterministic",
    "ldtk",
    "aseprite",
    "spritesheet",
    "cosmetics",
    "iap",
    "procedural-generation",
    "game-library"
  ],
  "homepage": "https://github.com/morganpage/aicraft-engine",
  "bugs": {
    "url": "https://github.com/morganpage/aicraft-engine/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/morganpage/aicraft-engine.git"
  },
  "author": "Morgan Page",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./terrain-art/editor": {
      "types": "./dist/terrain-art/reference-editor.d.ts",
      "import": "./dist/terrain-art/reference-editor.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit",
    "build:dist": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/fix-esm-specifiers.mjs",
    "prepack": "npm run build:dist",
    "prepublishOnly": "npm test && npm run release:smoke",
    "release:smoke": "node scripts/release-smoke.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "showcase:dev": "vite --config showcase/vite.config.ts",
    "showcase:build": "vite build --config showcase/vite.config.ts",
    "showcase:typecheck": "tsc --noEmit --project showcase/tsconfig.json",
    "showcase:test": "vitest run --config showcase/vitest.config.ts",
    "showcase:test:watch": "vitest --config showcase/vitest.config.ts",
    "benchmark:humanoid": "tsx benchmarks/_scripts/humanoid-validation-render.ts",
    "benchmark:charger": "tsx benchmarks/_scripts/charger-validation-render.ts",
    "benchmark:validation": "npm run benchmark:humanoid && npm run benchmark:charger",
    "bench:level-visual": "npx --yes tsx benchmarks/_scripts/level-visual-bench.ts",
    "visual:sheets": "node scripts/run-visual-sheets.mjs",
    "check:terrain-tree-shaking": "node scripts/check-terrain-tree-shaking.mjs",
    "check:level-visual-size": "node scripts/check-level-visual-size.mjs",
    "benchmark:terrain-art": "npx --yes tsx benchmarks/_scripts/terrain-art-baseline.ts",
    "check:terrain-art-runtime-size": "node scripts/check-terrain-art-runtime-size.mjs",
    "check:ldtk-runtime-size": "node scripts/check-ldtk-runtime-size.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "canvas": "^3.2.3",
    "tsx": "4.23.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
