{
  "name": "aicraft-engine",
  "version": "0.4.0",
  "type": "module",
  "description": "Ultra-minimalist procedural rendering + algorithmic cosmetics + IAP bridge for AI Craft games. Zero runtime dependencies.",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit",
    "build:dist": "tsc -p tsconfig.build.json",
    "prepack": "npm run build:dist",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "showcase:dev": "vite --config showcase/vite.config.ts",
    "showcase:build": "vite build --config showcase/vite.config.ts",
    "showcase:typecheck": "tsc --noEmit --project showcase/tsconfig.json",
    "showcase:test": "vitest run --config showcase/vitest.config.ts",
    "showcase:test:watch": "vitest --config showcase/vitest.config.ts",
    "benchmark:humanoid": "tsx benchmarks/_scripts/humanoid-validation-render.ts",
    "benchmark:charger": "tsx benchmarks/_scripts/charger-validation-render.ts",
    "benchmark:validation": "npm run benchmark:humanoid && npm run benchmark:charger",
    "bench:level-visual": "npx --yes tsx benchmarks/_scripts/level-visual-bench.ts",
    "visual:sheets": "node scripts/run-visual-sheets.mjs",
    "check:terrain-tree-shaking": "node scripts/check-terrain-tree-shaking.mjs",
    "check:level-visual-size": "node scripts/check-level-visual-size.mjs"
  },
  "devDependencies": {
    "canvas": "^3.2.3",
    "tsx": "4.23.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
