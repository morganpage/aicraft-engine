{
  "name": "aicraft-engine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Ultra-minimalist procedural rendering + algorithmic cosmetics + IAP bridge for AI Craft games. Zero runtime dependencies.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "showcase:dev": "vite --config showcase/vite.config.ts",
    "showcase:build": "vite build --config showcase/vite.config.ts",
    "showcase:typecheck": "tsc --noEmit --project showcase/tsconfig.json"
  },
  "devDependencies": {
    "canvas": "^3.2.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
